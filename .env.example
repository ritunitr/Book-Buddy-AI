# Anthropic API Key for Claude
ANTHROPIC_API_KEY=your_api_key_here

# Google Books API Key (used for candidate book retrieval)
GOOGLE_BOOKS_API_KEY=your_api_key_here

# LangSmith (observability - traces LLM calls and tool calls: latency, tokens,
# call counts). Optional: if unset, tracing is silently disabled and the app
# runs normally - these are never required for the app to function.
LANGSMITH_TRACING=true
LANGSMITH_API_KEY=your_api_key_here
LANGSMITH_PROJECT=book-buddy-ai
